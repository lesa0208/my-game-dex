# Seed data is always on under `next dev`. Set this to true to include it in a
# production build, for example on a preview deployment. It must be set for both
# `next build` and `next start`, because parts of each page are prerendered.
ENABLE_SEED_DATA=false

# Local database development needs no variables here. See "Local database" in
# the README. Never put real keys or passwords in this file.
