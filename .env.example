# Seed data is always on under `next dev`. Set this to true to include it in a
# production build, for example on a preview deployment. It must be set for both
# `next build` and `next start`, because parts of each page are prerendered.
ENABLE_SEED_DATA=false

# Local database development needs no variables here. See "Local database" in
# the README. Never put real keys or passwords in this file.

# The game catalog (M5c) and sign-in (M6a). Server-only, never NEXT_PUBLIC_: the app
# uses the project's publishable (anon) key, never a secret key, and keeps sessions in
# httpOnly cookies on the server. For the local stack, copy API_URL and the publishable
# key from `npx supabase status` into .env.local. Without them, Explore and game pages
# say the catalog isn't available, and signing in isn't available.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
