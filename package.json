{
  "name": "my-game-dex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:art": "node scripts/generate-seed-art.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "node scripts/db.mjs test",
    "db:verify": "node scripts/db.mjs verify",
    "db:mutation": "node scripts/db-mutation-checks.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:bundle": "node scripts/check-secrets.mjs --bundle",
    "secrets:test": "node --test scripts/check-secrets.test.mjs",
    "catalog:test": "node --test scripts/catalog-import-sources.test.mjs && node --experimental-strip-types --no-warnings --test src/features/catalog/parse.test.mjs",
    "catalog:import": "node scripts/catalog-import.mjs",
    "catalog:fixture": "node scripts/catalog-fixture.mjs",
    "auth:test": "node --experimental-strip-types --no-warnings --test src/features/auth/auth.test.mjs",
    "collection:test": "node --experimental-strip-types --no-warnings --test src/features/collection/collection.test.mjs",
    "app:auth-checks": "node scripts/app-auth-checks.mjs",
    "app:collection-checks": "node scripts/app-collection-checks.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "app:my-collection-checks": "node scripts/app-my-collection-checks.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "8.16.3",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
